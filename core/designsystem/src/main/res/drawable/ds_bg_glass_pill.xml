<?xml version="1.0" encoding="utf-8"?>
<!-- Translucent pill for chips sitting on a photo or brand gradient. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#29FFFFFF" />
            <stroke android:width="1dp" android:color="#47FFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</ripple>

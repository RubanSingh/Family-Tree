<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="SettingsRowView">
        <attr name="dsIcon" format="reference" />
        <attr name="dsIconStyle" format="enum">
            <enum name="neutral" value="0" />
            <enum name="primary" value="1" />
            <enum name="premium" value="2" />
        </attr>
        <attr name="dsTitle" format="string" />
        <attr name="dsSubtitle" format="string" />
        <attr name="dsValue" format="string" />
        <attr name="dsTrailing" format="enum">
            <enum name="none" value="0" />
            <enum name="chevron" value="1" />
            <enum name="switchControl" value="2" />
            <enum name="value" value="3" />
            <enum name="lock" value="4" />
        </attr>
        <attr name="dsShowDivider" format="boolean" />
        <!-- Shows the gold "Premium" badge above the title -->
        <attr name="dsPremiumBadge" format="boolean" />
    </declare-styleable>
</resources>

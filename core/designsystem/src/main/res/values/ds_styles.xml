<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== Shape ===== -->
    <style name="ShapeAppearance.FamilyTree.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">@dimen/ds_radius_sm</item>
    </style>
    <style name="ShapeAppearance.FamilyTree.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/ds_radius_md</item>
    </style>
    <style name="ShapeAppearance.FamilyTree.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">@dimen/ds_radius_lg</item>
    </style>
    <style name="ShapeAppearance.FamilyTree.Full" parent="ShapeAppearance.Material3.Corner.Full" />

    <!-- ===== App bar ===== -->
    <style name="Widget.FamilyTree.Toolbar" parent="Widget.Material3.Toolbar.OnSurface">
        <item name="android:background">?attr/colorSurface</item>
        <item name="android:elevation">0dp</item>
        <item name="titleTextAppearance">@style/TextAppearance.FamilyTree.TitleLarge</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.FamilyTree.BodyMedium</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
        <item name="subtitleTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="navigationIconTint">?attr/colorOnSurface</item>
        <item name="android:minHeight">?attr/actionBarSize</item>
    </style>
    <style name="Widget.FamilyTree.Toolbar.Tonal">
        <item name="android:background">?attr/colorSurfaceContainer</item>
    </style>

    <!-- ===== Cards ===== -->
    <style name="Widget.FamilyTree.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="cardCornerRadius">@dimen/ds_radius_md</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.FamilyTree.Medium</item>
    </style>
    <style name="Widget.FamilyTree.Card.High">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerHigh</item>
    </style>
    <style name="Widget.FamilyTree.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">@dimen/ds_radius_md</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.FamilyTree.Medium</item>
    </style>
    <style name="Widget.FamilyTree.Card.Elevated" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/ds_radius_md</item>
        <item name="cardElevation">1dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.FamilyTree.Medium</item>
    </style>
    <style name="Widget.FamilyTree.Card.Primary">
        <item name="cardBackgroundColor">?attr/colorPrimaryContainer</item>
    </style>
    <style name="Widget.FamilyTree.Card.Premium">
        <item name="cardBackgroundColor">?attr/colorTertiaryContainer</item>
    </style>

    <!-- ===== Buttons ===== -->
    <style name="Widget.FamilyTree.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/ds_touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">@dimen/ds_space_lg</item>
        <item name="android:paddingEnd">@dimen/ds_space_lg</item>
        <item name="android:textAppearance">@style/TextAppearance.FamilyTree.LabelLarge</item>
        <item name="shapeAppearance">@style/ShapeAppearance.FamilyTree.Full</item>
    </style>
    <style name="Widget.FamilyTree.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/ds_touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.FamilyTree.LabelLarge</item>
        <item name="shapeAppearance">@style/ShapeAppearance.FamilyTree.Full</item>
    </style>
    <style name="Widget.FamilyTree.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/ds_touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.FamilyTree.LabelLarge</item>
        <item name="shapeAppearance">@style/ShapeAppearance.FamilyTree.Full</item>
    </style>
    <style name="Widget.FamilyTree.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/ds_touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.FamilyTree.LabelLarge</item>
        <item name="shapeAppearance">@style/ShapeAppearance.FamilyTree.Full</item>
    </style>
    <style name="Widget.FamilyTree.Button.Premium">
        <item name="backgroundTint">?attr/colorTertiaryContainer</item>
        <item name="android:textColor">?attr/colorOnTertiaryContainer</item>
        <item name="iconTint">?attr/colorOnTertiaryContainer</item>
    </style>
    <style name="Widget.FamilyTree.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="Widget.FamilyTree.IconButton.Filled" parent="Widget.Material3.Button.IconButton.Filled" />
    <style name="Widget.FamilyTree.IconButton.Tonal" parent="Widget.Material3.Button.IconButton.Filled.Tonal" />

    <style name="Widget.FamilyTree.FAB" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="shapeAppearance">@style/ShapeAppearance.FamilyTree.Medium</item>
    </style>
    <style name="Widget.FamilyTree.ExtendedFAB" parent="Widget.Material3.ExtendedFloatingActionButton.Primary">
        <item name="shapeAppearance">@style/ShapeAppearance.FamilyTree.Medium</item>
    </style>

    <!-- ===== Selection controls ===== -->
    <style name="Widget.FamilyTree.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch" />
    <style name="Widget.FamilyTree.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">?attr/colorSurfaceContainerHigh</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.FamilyTree.LabelMedium</item>
    </style>
    <style name="Widget.FamilyTree.Chip.Filter" parent="Widget.Material3.Chip.Filter" />

    <!-- ===== Lists ===== -->
    <style name="Widget.FamilyTree.SectionHeader" parent="Widget.MaterialComponents.TextView">
        <item name="android:textAppearance">@style/TextAppearance.FamilyTree.LabelLarge</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:paddingStart">@dimen/ds_space_md</item>
        <item name="android:paddingEnd">@dimen/ds_space_md</item>
        <item name="android:paddingTop">@dimen/ds_space_lg</item>
        <item name="android:paddingBottom">@dimen/ds_space_sm</item>
    </style>
    <style name="Widget.FamilyTree.ListTitle" parent="Widget.MaterialComponents.TextView">
        <item name="android:textAppearance">@style/TextAppearance.FamilyTree.TitleMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="Widget.FamilyTree.ListSubtitle" parent="Widget.MaterialComponents.TextView">
        <item name="android:textAppearance">@style/TextAppearance.FamilyTree.BodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="Widget.FamilyTree.Caption" parent="Widget.MaterialComponents.TextView">
        <item name="android:textAppearance">@style/TextAppearance.FamilyTree.BodySmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="Widget.FamilyTree.Divider" parent="Widget.Material3.MaterialDivider">
        <item name="dividerColor">?attr/colorOutlineVariant</item>
    </style>
    <style name="Widget.FamilyTree.IconContainer" parent="">
        <item name="android:layout_width">@dimen/ds_icon_container</item>
        <item name="android:layout_height">@dimen/ds_icon_container</item>
        <item name="android:padding">@dimen/ds_space_sm</item>
        <item name="android:background">@drawable/ds_bg_icon_container</item>
        <item name="android:scaleType">centerInside</item>
        <item name="tint">?attr/colorOnSecondaryContainer</item>
    </style>
    <style name="Widget.FamilyTree.IconContainer.Primary">
        <item name="android:background">@drawable/ds_bg_icon_container_primary</item>
        <item name="tint">?attr/colorOnPrimaryContainer</item>
    </style>
    <style name="Widget.FamilyTree.IconContainer.Premium">
        <item name="android:background">@drawable/ds_bg_icon_container_premium</item>
        <item name="tint">?attr/colorOnTertiaryContainer</item>
    </style>
    <style name="Widget.FamilyTree.Pill" parent="Widget.MaterialComponents.TextView">
        <item name="android:textAppearance">@style/TextAppearance.FamilyTree.LabelMedium</item>
        <item name="android:paddingStart">@dimen/ds_space_ms</item>
        <item name="android:paddingEnd">@dimen/ds_space_ms</item>
        <item name="android:paddingTop">@dimen/ds_space_xs</item>
        <item name="android:paddingBottom">@dimen/ds_space_xs</item>
        <item name="android:background">@drawable/ds_bg_pill_primary</item>
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
    </style>
    <style name="Widget.FamilyTree.Pill.Premium">
        <item name="android:background">@drawable/ds_bg_pill_premium</item>
        <item name="android:textColor">?attr/colorOnTertiaryContainer</item>
    </style>

    <!-- ===== Dialogs ===== -->
    <style name="ThemeOverlay.FamilyTree.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.FamilyTree.Large</item>
    </style>
</resources>

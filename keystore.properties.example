# Copy to keystore.properties (git-ignored) to sign release builds and use your own AdMob IDs.
# Without keystore.properties, release builds are signed with the debug key and Google's sample ad IDs are used.

# Release signing (storeFile is relative to the project root)
storeFile=cert/your-release-key.jks
storePassword=change-me
keyAlias=your-key-alias
keyPassword=change-me

# AdMob
admobAppId=ca-app-pub-0000000000000000~0000000000
adUnitNative=ca-app-pub-0000000000000000/0000000000
adUnitInterstitial=ca-app-pub-0000000000000000/0000000000
adUnitRewarded=ca-app-pub-0000000000000000/0000000000

    <string name="paywall_faq_title">أسئلة وأجوبة</string>
    <string name="paywall_faq_plans_q">ما الفرق بين الخطة الشهرية وخطة مدى الحياة؟</string>
    <string name="paywall_faq_plans_a">كلتاهما تتيحان كل ما في Premium. تتجدد الخطة الشهرية كل شهر ويمكنك إلغاؤها في أي وقت. أما خطة مدى الحياة فتُدفع مرة واحدة ولا تنتهي أبدًا.</string>
    <string name="paywall_faq_cancel_q">ماذا يحدث لأشجاري إذا أوقفت Premium؟</string>
    <string name="paywall_faq_cancel_a">لن تفقد شيئًا. تبقى أشجارك وصورك وتذكيراتك ونسخك الاحتياطية كما هي تمامًا: تتوقف ميزات Premium فقط وتعود الإعلانات.</string>
    <string name="paywall_faq_device_q">غيّرت هاتفي. هل عليّ الدفع مجددًا؟</string>
    <string name="paywall_faq_device_a">لا. ثبّت Family Tree بحساب Google نفسه واضغط على «استعادة المشتريات».</string>
    <string name="paywall_faq_privacy_q">هل تُرسَل بيانات عائلتي إلى أي مكان؟</string>
    <string name="paywall_faq_privacy_a">لا. تُحفظ أشجارك على جهازك وفي مجلد النسخ الاحتياطي الذي تختاره. شراء Premium لا يرفع أي شيء.</string>
    <string name="paywall_faq_manage_q">كيف ألغي الخطة الشهرية؟</string>
    <string name="paywall_faq_manage_a">في متجر Play، افتح المدفوعات والاشتراكات › الاشتراكات، واختر Family Tree ثم اضغط على «إلغاء». يبقى Premium مفعّلًا حتى نهاية الفترة المدفوعة.</string>

    <!-- Premium features: groups -->
    <string name="pf_group_safe">في أمان دائم</string>
    <string name="pf_group_safe_desc">سنوات من البحث، محمية تلقائيًا.</string>
    <string name="pf_group_moments">لا تفوّت أي لحظة</string>
    <string name="pf_group_moments_desc">تواريخ عائلتك وأماكنها، دائمًا في متناول يدك.</string>
    <string name="pf_group_share">أنشئ وشارك</string>
    <string name="pf_group_share_desc">تصدير أنيق وأدوات قوية للبحث الجاد.</string>
    <string name="pf_group_yours">اجعله على ذوقك</string>
    <string name="pf_group_yours_desc">مساحة هادئة وشخصية لقصة عائلتك.</string>

    <!-- Premium features -->
    <string name="pf_backup_title">نسخ احتياطي تلقائي</string>
    <string name="pf_backup_summary">يُحفظ كل تغيير في مجلد تختاره، دون أي جهد منك.</string>
    <string name="pf_backup_free">نسخ احتياطي يدوي</string>
    <string name="pf_backup_premium">تلقائي</string>
    <string name="pf_backup_detail1">بعد دقيقة من كل تعديل، تُحفظ الشجرة كنسخة احتياطية بصيغة ZIP في مجلدك: ذاكرة الهاتف أو بطاقة SD أو مجلد سحابي مثل Google Drive.</string>
    <string name="pf_backup_detail2">يُحتفظ بأحدث 3 نسخ لكل شجرة، لتتمكن دائمًا من الرجوع إليها.</string>
    <string name="pf_backup_detail3">استعادة النسخة الاحتياطية مجانية ومتاحة دائمًا، حتى دون Premium.</string>

    <string name="pf_media_title">منظّم الوسائط</string>
    <string name="pf_media_summary">انسخ كل صور الشجرة ومستنداتها إلى التطبيق دفعة واحدة.</string>
    <string name="pf_media_free">ملف واحد في كل مرة</string>
    <string name="pf_media_premium">كل الملفات دفعة واحدة</string>
    <string name="pf_media_detail1">انقل كل وسائط الشجرة إلى مخزن التطبيق، مع عرض التقدّم وإمكانية الإلغاء، كي لا تنقطع الروابط أبدًا عند نقل الملفات.</string>
    <string name="pf_media_detail2">تبقى ملفاتك الأصلية كما هي: يُنسخ كل ملف ويُتحقق منه قبل تحديث روابطه.</string>

    <string name="pf_reminders_title">تذكيرات عائلية ذكية</string>
    <string name="pf_reminders_summary">ذكريات الزواج، وذكريات الوفاة، وتذكيرات شخصية غير محدودة.</string>
    <string name="pf_reminders_free">أعياد الميلاد + تذكيران</string>
    <string name="pf_reminders_premium">غير محدودة</string>
    <string name="pf_reminders_detail1">تلقَّ تنبيهات بذكريات زواج الأزواج، وبذكريات الوفاة إن شئت.</string>
    <string name="pf_reminders_detail2">أنشئ ما تشاء من التذكيرات: حفلات استقبال المواليد، والتخرّج، ولمّ شمل العائلة، والزيارات…</string>
    <string name="pf_reminders_detail3">تُعلمك التنبيهات المبكرة مسبقًا، فيتّسع الوقت للاتصال أو الكتابة أو التخطيط لهدية.</string>

    <string name="pf_places_title">أماكن العائلة</string>
    <string name="pf_places_summary">كل مكان في تاريخ عائلتك، قابل للبحث وعلى بُعد نقرة من الخريطة.</string>
    <string name="pf_places_free">أول 3 أماكن</string>
    <string name="pf_places_premium">كل الأماكن</string>
    <string name="pf_places_detail1">كل أماكن الأحداث والعناوين في الشجرة، مجمّعة حسب البلد، مع البحث.</string>
    <string name="pf_places_detail2">اطّلع على ما حدث في كل مكان وافتحه في تطبيق الخرائط، مع الاتجاهات.</string>

    <string name="pf_exports_title">تصدير جاهز للطباعة</string>
    <string name="pf_exports_summary">حوّل مخططك إلى صورة عالية الدقة أو ملف PDF للطباعة والمشاركة.</string>
    <string name="pf_exports_free_legacy">PDF</string>
    <string name="pf_exports_free_video">مرة واحدة لكل فيديو</string>
    <string name="pf_exports_premium">PDF + صورة عالية الدقة</string>
    <string name="pf_exports_detail1">صدّر المخطط كصورة PNG عالية الدقة، مثالية للمحادثات وشبكات التواصل الاجتماعي.</string>
    <string name="pf_exports_detail2">أنشئ ملف PDF للمخطط كاملًا، جاهزًا للطباعة كملصق لتجمّعات العائلة.</string>
    <string name="pf_exports_detail3">تنسيق للطباعة بخلفية بيضاء وخطوط واضحة، بمقاس يناسب شجرتك.</string>
    <string name="pf_exports_detail4">حتى دون Premium، يمكنك التصدير مرة واحدة بعد مشاهدة فيديو قصير.</string>

    <string name="pf_merge_title">دمج الأشجار</string>
    <string name="pf_merge_summary">اجمع شجرتين في شجرة واحدة، ويعثر التطبيق على التكرارات نيابةً عنك.</string>
    <string name="pf_merge_detail1">يبحث التطبيق عن الأشخاص أنفسهم في الشجرتين ويتيح لك تأكيد كل تطابق، أو تأكيدها كلها دفعة واحدة.</string>
    <string name="pf_merge_detail2">مثالي عندما يرسل إليك أقاربك شجرتهم الخاصة.</string>

    <string name="pf_advanced_title">أدوات متقدمة</string>
    <string name="pf_advanced_summary">المصادر، والمستودعات، وتصدير GEDCOM، ومجموعة أدوات علم الأنساب كاملة.</string>
    <string name="pf_advanced_detail1">استشهد بالمصادر والمستودعات وأدِر المقدّمين، كعلماء الأنساب المحترفين.</string>
    <string name="pf_advanced_detail2">صدّر شجرتك بصيغة GEDCOM، مع الوسائط أو بدونها، لأي برنامج أنساب، وأنشئ نسخًا احتياطية ZIP كاملة.</string>
    <string name="pf_advanced_detail3">قارن الأشجار المشتركة ورتّب مسارات ملفات الوسائط.</string>

    <string name="pf_no_ads_title">بلا إعلانات</string>
    <string name="pf_no_ads_summary">مساحة هادئة ومركّزة لقصة عائلتك.</string>
    <string name="pf_no_ads_free">مع إعلانات</string>
    <string name="pf_no_ads_premium">بلا إعلانات</string>
    <string name="pf_no_ads_detail1">لا إعلانات في القوائم ولا في الملفات الشخصية ولا بين المهام.</string>
    <string name="pf_no_ads_detail2">يدعم Premium أيضًا تطوير Family Tree.</string>

    <string name="pf_themes_title">20 سمة لونية</string>
    <string name="pf_themes_summary">اجعل التطبيق على ذوقك، بالوضع الفاتح أو الداكن.</string>
    <string name="pf_themes_free">السمة الكلاسيكية</string>
    <string name="pf_themes_premium">20 سمة</string>
    <string name="pf_themes_detail1">اختر من بين 20 سمة لونية، من النيلي العميق إلى الكهرماني الدافئ.</string>
    <string name="pf_themes_detail2">كل سمة تعمل بالوضعين الفاتح والداكن.</string>
</resources>

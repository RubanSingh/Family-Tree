<?xml version="1.0" encoding="utf-8"?>
<!-- Local backup: on/off hero, folder, trees to back up, saved backups (rows added by BackupController) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.FamilyTree.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/backup_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="invisible" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/ds_space_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ds_page_gutter"
            android:paddingTop="@dimen/ds_space_xs"
            android:paddingEnd="@dimen/ds_page_gutter">

            <!-- Hero: on / off -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FamilyTree.Card.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/ds_radius_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/Widget.FamilyTree.IconContainer"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:padding="12dp"
                            android:background="@drawable/ds_bg_logo_tile"
                            android:backgroundTint="?attr/colorSurface"
                            android:contentDescription="@null"
                            android:src="@drawable/ds_ic_backup"
                            app:tint="?attr/colorPrimary" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/backup_auto_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ds_space_md"
                            android:layout_weight="1"
                            android:text="@string/backup_auto_title"
                            android:textAppearance="?attr/textAppearanceTitleLarge"
                            android:textColor="?attr/colorOnPrimaryContainer" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/backup_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/backup_auto_title" />
                    </LinearLayout>

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_ms"
                        android:text="@string/backup_auto_desc"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnPrimaryContainer" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/backup_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Folder -->
                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.FamilyTree.SectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/ds_space_xs"
                    android:text="@string/backup_folder" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.FamilyTree.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/ds_space_md">

                        <ImageView
                            android:id="@+id/backup_folder_icon"
                            style="@style/Widget.FamilyTree.IconContainer"
                            android:contentDescription="@null"
                            android:src="@drawable/ds_ic_folder" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ds_space_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/backup_folder_name"
                                style="@style/Widget.FamilyTree.ListTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="middle"
                                android:singleLine="true" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/backup_folder_status"
                                style="@style/Widget.FamilyTree.ListSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/backup_choose"
                            style="@style/Widget.FamilyTree.Button.Tonal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ds_space_sm"
                            android:minHeight="40dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Trees -->
                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.FamilyTree.SectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/ds_space_xs"
                    android:text="@string/backup_trees_section" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.FamilyTree.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="@dimen/ds_space_xs"
                        android:paddingBottom="@dimen/ds_space_md">

                        <LinearLayout
                            android:id="@+id/backup_trees"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/backup_now"
                            style="@style/Widget.FamilyTree.Button"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ds_space_md"
                            android:layout_marginTop="@dimen/ds_space_sm"
                            android:layout_marginEnd="@dimen/ds_space_md"
                            android:text="@string/backup_now"
                            app:icon="@drawable/ds_ic_backup"
                            app:iconGravity="textStart" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Saved backups -->
                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.FamilyTree.SectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/ds_space_xs"
                    android:text="@string/backup_saved_section" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.FamilyTree.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/backup_files"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="72dp"
                        android:orientation="vertical"
                        android:paddingTop="@dimen/ds_space_xs"
                        android:paddingBottom="@dimen/ds_space_xs" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>

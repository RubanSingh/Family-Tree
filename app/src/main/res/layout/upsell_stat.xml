<?xml version="1.0" encoding="utf-8"?>
<!-- A number of the user's trees on the Premium invitation hero (glass tile). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/upsell_stat_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="@dimen/ds_space_sm"
    android:paddingBottom="@dimen/ds_space_sm">

    <TextView
        android:id="@+id/upsell_stat_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="?attr/colorOnTertiaryContainer"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/upsell_stat_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnTertiaryContainer" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Diagram settings: how many generations of each kind of relative the tree shows.
    Grouped like the app Settings screen; each slider shows its value next to the title,
    and settings_indicator floats above the slider while it is being dragged.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.FamilyTree.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/ds_space_xl">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/ds_page_gutter"
                android:paddingTop="@dimen/ds_space_sm"
                android:paddingEnd="@dimen/ds_page_gutter">

                <!-- Intro -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.FamilyTree.Card.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/ds_space_md">

                        <ImageView
                            style="@style/Widget.FamilyTree.IconContainer"
                            android:background="@drawable/ds_bg_logo_tile"
                            android:backgroundTint="?attr/colorSurface"
                            android:contentDescription="@null"
                            android:src="@drawable/ds_ic_account_tree"
                            app:tint="?attr/colorPrimary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ds_space_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/diagram_settings_hint_title"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="?attr/colorOnPrimaryContainer" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/generations_display_diagram"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnPrimaryContainer" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.FamilyTree.SectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/ds_space_xs"
                    android:text="@string/diagram_settings_section_ancestry" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.FamilyTree.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="@dimen/ds_space_sm">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/ds_space_md"
                        android:paddingTop="@dimen/ds_space_md"
                        android:paddingEnd="@dimen/ds_space_md"
                        android:paddingBottom="@dimen/ds_space_xs">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                style="@style/Widget.FamilyTree.IconContainer"
                                android:contentDescription="@null"
                                android:src="@drawable/ds_ic_arrow_up" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/ds_space_md"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <com.google.android.material.textview.MaterialTextView
                                    style="@style/Widget.FamilyTree.ListTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ancestors" />

                                <com.google.android.material.textview.MaterialTextView
                                    style="@style/Widget.FamilyTree.ListSubtitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/diagram_settings_ancestors_desc" />
                            </LinearLayout>

                            <!-- Current value, kept in sync by DiagramSettingsController -->
                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/settings_ancestors_value"
                                style="@style/Widget.FamilyTree.Pill"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/ds_space_ms"
                                android:gravity="center"
                                android:minWidth="36dp" />
                        </LinearLayout>

                        <SeekBar
                            android:id="@+id/settings_ancestors"
                            style="@style/Widget.FamilyTree.SeekBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="60dp"
                            android:layout_marginEnd="@dimen/ds_space_xs"
                            android:max="9" />
                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="72dp"
                        android:layout_marginEnd="@dimen/ds_space_md" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/ds_space_md"
                        android:paddingTop="@dimen/ds_space_md"
                        android:paddingEnd="@dimen/ds_space_md"
                        android:paddingBottom="@dimen/ds_space_xs">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                style="@style/Widget.FamilyTree.IconContainer"
                                android:contentDescription="@null"
                                android:src="@drawable/ds_ic_groups" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/ds_space_md"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <com.google.android.material.textview.MaterialTextView
                                    style="@style/Widget.FamilyTree.ListTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/uncles_great_uncles" />

                                <com.google.android.material.textview.MaterialTextView
                                    style="@style/Widget.FamilyTree.ListSubtitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/diagram_settings_great_uncles_desc" />
                            </LinearLayout>

                            <!-- Current value, kept in sync by DiagramSettingsController -->
                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/settings_great_uncles_value"
                                style="@style/Widget.FamilyTree.Pill"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/ds_space_ms"
                                android:gravity="center"
                                android:minWidth="36dp" />
                        </LinearLayout>

                        <SeekBar
                            android:id="@+id/settings_great_uncles"
                            style="@style/Widget.FamilyTree.SeekBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="60dp"
                            android:layout_marginEnd="@dimen/ds_space_xs"
                            android:max="9" />
                    </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.FamilyTree.SectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/ds_space_xs"
                    android:text="@string/diagram_settings_section_partners" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.FamilyTree.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="@dimen/ds_space_sm">

                        <!-- Whole row toggles: the switch is laid over the row content -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:minHeight="72dp"
                                android:orientation="horizontal"
                                android:paddingStart="@dimen/ds_space_md"
                                android:paddingTop="@dimen/ds_space_ms"
                                android:paddingEnd="80dp"
                                android:paddingBottom="@dimen/ds_space_ms">

                                <ImageView
                                    style="@style/Widget.FamilyTree.IconContainer"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ds_ic_favorite" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/ds_space_md"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <com.google.android.material.textview.MaterialTextView
                                        style="@style/Widget.FamilyTree.ListTitle"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/partners" />

                                    <com.google.android.material.textview.MaterialTextView
                                        style="@style/Widget.FamilyTree.ListSubtitle"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="@string/diagram_settings_partners_desc" />
                                </LinearLayout>
                            </LinearLayout>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/settings_spouses"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="?attr/selectableItemBackground"
                                android:contentDescription="@string/partners"
                                android:gravity="center_vertical"
                                android:paddingEnd="@dimen/ds_space_md" />
                        </FrameLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.FamilyTree.SectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/ds_space_xs"
                    android:text="@string/diagram_settings_section_descendants" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.FamilyTree.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="@dimen/ds_space_sm">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/ds_space_md"
                        android:paddingTop="@dimen/ds_space_md"
                        android:paddingEnd="@dimen/ds_space_md"
                        android:paddingBottom="@dimen/ds_space_xs">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                style="@style/Widget.FamilyTree.IconContainer"
                                android:contentDescription="@null"
                                android:src="@drawable/ds_ic_arrow_down" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/ds_space_md"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <com.google.android.material.textview.MaterialTextView
                                    style="@style/Widget.FamilyTree.ListTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/descendants" />

                                <com.google.android.material.textview.MaterialTextView
                                    style="@style/Widget.FamilyTree.ListSubtitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/diagram_settings_descendants_desc" />
                            </LinearLayout>

                            <!-- Current value, kept in sync by DiagramSettingsController -->
                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/settings_descendants_value"
                                style="@style/Widget.FamilyTree.Pill"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/ds_space_ms"
                                android:gravity="center"
                                android:minWidth="36dp" />
                        </LinearLayout>

                        <SeekBar
                            android:id="@+id/settings_descendants"
                            style="@style/Widget.FamilyTree.SeekBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="60dp"
                            android:layout_marginEnd="@dimen/ds_space_xs"
                            android:max="9" />
                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="72dp"
                        android:layout_marginEnd="@dimen/ds_space_md" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/ds_space_md"
                        android:paddingTop="@dimen/ds_space_md"
                        android:paddingEnd="@dimen/ds_space_md"
                        android:paddingBottom="@dimen/ds_space_xs">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                style="@style/Widget.FamilyTree.IconContainer"
                                android:contentDescription="@null"
                                android:src="@drawable/ds_ic_family" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/ds_space_md"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <com.google.android.material.textview.MaterialTextView
                                    style="@style/Widget.FamilyTree.ListTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/siblings_nephews" />

                                <com.google.android.material.textview.MaterialTextView
                                    style="@style/Widget.FamilyTree.ListSubtitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/diagram_settings_siblings_desc" />
                            </LinearLayout>

                            <!-- Current value, kept in sync by DiagramSettingsController -->
                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/settings_siblings_nephews_value"
                                style="@style/Widget.FamilyTree.Pill"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/ds_space_ms"
                                android:gravity="center"
                                android:minWidth="36dp" />
                        </LinearLayout>

                        <SeekBar
                            android:id="@+id/settings_siblings_nephews"
                            style="@style/Widget.FamilyTree.SeekBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="60dp"
                            android:layout_marginEnd="@dimen/ds_space_xs"
                            android:max="9" />
                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="72dp"
                        android:layout_marginEnd="@dimen/ds_space_md" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/ds_space_md"
                        android:paddingTop="@dimen/ds_space_md"
                        android:paddingEnd="@dimen/ds_space_md"
                        android:paddingBottom="@dimen/ds_space_xs">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                style="@style/Widget.FamilyTree.IconContainer"
                                android:contentDescription="@null"
                                android:src="@drawable/ds_ic_groups" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/ds_space_md"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <com.google.android.material.textview.MaterialTextView
                                    style="@style/Widget.FamilyTree.ListTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/uncles_cousins" />

                                <com.google.android.material.textview.MaterialTextView
                                    style="@style/Widget.FamilyTree.ListSubtitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/diagram_settings_cousins_desc" />
                            </LinearLayout>

                            <!-- Current value, kept in sync by DiagramSettingsController -->
                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/settings_uncles_cousins_value"
                                style="@style/Widget.FamilyTree.Pill"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/ds_space_ms"
                                android:gravity="center"
                                android:minWidth="36dp" />
                        </LinearLayout>

                        <SeekBar
                            android:id="@+id/settings_uncles_cousins"
                            style="@style/Widget.FamilyTree.SeekBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="60dp"
                            android:layout_marginEnd="@dimen/ds_space_xs"
                            android:max="9" />
                    </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>


                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.FamilyTree.SectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/ds_space_xs"
                    android:text="@string/diagram_settings_section_display" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.FamilyTree.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <!-- Whole row toggles: the switch is laid over the row content -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:minHeight="72dp"
                                android:orientation="horizontal"
                                android:paddingStart="@dimen/ds_space_md"
                                android:paddingTop="@dimen/ds_space_ms"
                                android:paddingEnd="80dp"
                                android:paddingBottom="@dimen/ds_space_ms">

                                <ImageView
                                    style="@style/Widget.FamilyTree.IconContainer"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ds_ic_groups" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/ds_space_md"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <com.google.android.material.textview.MaterialTextView
                                        style="@style/Widget.FamilyTree.ListTitle"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/numbers" />

                                    <com.google.android.material.textview.MaterialTextView
                                        style="@style/Widget.FamilyTree.ListSubtitle"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="@string/diagram_settings_numbers_desc" />
                                </LinearLayout>
                            </LinearLayout>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/settings_numbers"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="?attr/selectableItemBackground"
                                android:contentDescription="@string/numbers"
                                android:gravity="center_vertical"
                                android:paddingEnd="@dimen/ds_space_md" />
                        </FrameLayout>

                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="72dp"
                            android:layout_marginEnd="@dimen/ds_space_md" />
                        <!-- Whole row toggles: the switch is laid over the row content -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:minHeight="72dp"
                                android:orientation="horizontal"
                                android:paddingStart="@dimen/ds_space_md"
                                android:paddingTop="@dimen/ds_space_ms"
                                android:paddingEnd="80dp"
                                android:paddingBottom="@dimen/ds_space_ms">

                                <ImageView
                                    style="@style/Widget.FamilyTree.IconContainer"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ds_ic_swap" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/ds_space_md"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <com.google.android.material.textview.MaterialTextView
                                        style="@style/Widget.FamilyTree.ListTitle"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/duplicates_lines" />

                                    <com.google.android.material.textview.MaterialTextView
                                        style="@style/Widget.FamilyTree.ListSubtitle"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="@string/diagram_settings_duplicates_desc" />
                                </LinearLayout>
                            </LinearLayout>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/settings_duplicates"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="?attr/selectableItemBackground"
                                android:contentDescription="@string/duplicates_lines"
                                android:gravity="center_vertical"
                                android:paddingEnd="@dimen/ds_space_md" />
                        </FrameLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Value bubble that follows the dragged slider (positioned by DiagramSettingsController) -->
            <LinearLayout
                android:id="@+id/settings_indicator"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:elevation="6dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/settings_indicator_text"
                    style="@style/Widget.FamilyTree.ValueBubble"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="6dp"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    app:srcCompat="@drawable/ds_tooltip_tail"
                    app:tint="?attr/colorPrimary" />
            </LinearLayout>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>

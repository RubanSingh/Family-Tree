<?xml version="1.0" encoding="utf-8"?>
<!-- Source chip-card (inside citations and on records) -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_marginTop="2dp"
	android:layout_marginBottom="2dp"
	app:cardBackgroundColor="@color/source"
	app:cardCornerRadius="12dp"
	app:cardElevation="0dp"
	app:strokeWidth="0dp"
	app:contentPadding="@dimen/ds_space_ms">
	<LinearLayout
		android:id="@+id/fonte_scatola"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical">
		<com.google.android.material.textview.MaterialTextView
			android:id="@+id/fonte_testo"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:ellipsize="end"
			android:maxLines="8"
			android:textAppearance="@style/TextAppearance.FamilyTree.BodyMedium"/>
	</LinearLayout>
</com.google.android.material.card.MaterialCardView>

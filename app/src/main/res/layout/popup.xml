<?xml version="1.0" encoding="utf-8"?>
<!-- Hint bubble shown above a card on the tree canvas -->
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/popup_fumetto"
	android:layout_width="wrap_content"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:gravity="center_horizontal"
	app:layout_constraintStart_toStartOf="parent"
	app:layout_constraintEnd_toEndOf="parent">
	<TextView
		android:id="@+id/popup_testo"
		style="@style/Widget.FamilyTree.Tooltip.Canvas"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:elevation="0dp"
		android:gravity="center"
		android:text="@string/long_press_menu"/>
	<ImageView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginBottom="@dimen/ds_space_xs"
		android:contentDescription="@null"
		app:srcCompat="@drawable/ds_tooltip_tail_canvas"/>
</LinearLayout>

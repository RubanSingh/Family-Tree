<?xml version="1.0" encoding="utf-8"?>
<!-- "Last changed" footer at the end of a profile or record -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_marginTop="@dimen/ds_space_lg"
	android:paddingStart="@dimen/ds_space_xs"
	android:paddingEnd="@dimen/ds_space_xs">

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginEnd="6dp"
		android:layout_toStartOf="@id/cambi_testo"
		android:text="@string/change_date"
		android:textAppearance="@style/TextAppearance.FamilyTree.BodySmall"
		android:textColor="?attr/colorOnSurfaceVariant"/>

	<TextView
		android:id="@+id/cambi_testo"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_alignParentEnd="true"
		android:textAppearance="@style/TextAppearance.FamilyTree.LabelMedium"
		android:textColor="?attr/colorOnSurfaceVariant"/>

	<LinearLayout
		android:id="@+id/cambi_note"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_below="@id/cambi_testo"
		android:orientation="vertical" />

</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Hint bubble pointing at the FAB on the trees list -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="wrap_content"
	android:layout_height="wrap_content"
	android:gravity="end"
	android:orientation="vertical">
	<TextView
		android:id="@+id/fabuloso_text"
		style="@style/Widget.FamilyTree.Tooltip"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginStart="@dimen/ds_space_md"
		android:layout_marginEnd="@dimen/ds_space_md"
		android:elevation="0dp"
		android:text="@string/tap_add_tree"/>
	<ImageView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginEnd="36dp"
		android:contentDescription="@null"
		app:srcCompat="@drawable/ds_tooltip_tail"/>
</LinearLayout>

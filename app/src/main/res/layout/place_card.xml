<?xml version="1.0" encoding="utf-8"?>
<!-- A place of the tree with its numbers and map actions -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.FamilyTree.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/ds_page_gutter"
    android:layout_marginTop="5dp"
    android:layout_marginEnd="@dimen/ds_page_gutter"
    android:layout_marginBottom="5dp"
    app:cardCornerRadius="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ds_space_md"
        android:paddingTop="@dimen/ds_space_ms"
        android:paddingEnd="@dimen/ds_space_sm"
        android:paddingBottom="@dimen/ds_space_xs">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                style="@style/Widget.FamilyTree.IconContainer.Primary"
                android:contentDescription="@null"
                android:src="@drawable/ds_ic_place" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/place_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.FamilyTree.TitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Florence" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/place_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.FamilyTree.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="Tuscany, Italy" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/place_stats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorPrimary"
                    tools:text="12 events · 7 people" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/place_map"
                style="@style/Widget.FamilyTree.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/places_show_map"
                app:icon="@drawable/ds_ic_map" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/place_directions"
                style="@style/Widget.FamilyTree.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/places_directions"
                app:icon="@drawable/ds_ic_directions" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

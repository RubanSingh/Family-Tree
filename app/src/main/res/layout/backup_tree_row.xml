<?xml version="1.0" encoding="utf-8"?>
<!-- A tree that can be included in the backup -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/ds_space_md"
    android:paddingTop="@dimen/ds_space_sm"
    android:paddingEnd="@dimen/ds_space_sm"
    android:paddingBottom="@dimen/ds_space_sm">

    <TextView
        android:id="@+id/backup_tree_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/ds_bg_avatar"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnPrimaryContainer" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_space_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/backup_tree_title"
            style="@style/Widget.FamilyTree.ListTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true" />

        <TextView
            android:id="@+id/backup_tree_detail"
            style="@style/Widget.FamilyTree.ListSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/backup_tree_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false" />
</LinearLayout>

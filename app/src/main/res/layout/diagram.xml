<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

	<!-- Tree canvas: pan + pinch zoom -->
	<dna.familytree.MoveLayout
		android:id="@+id/diagram_frame"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="@drawable/diagram_background"
		android:layoutDirection="ltr">
		<RelativeLayout
			android:id="@+id/diagram_box"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:clipChildren="false"
			android:clipToPadding="false"
			android:layoutDirection="ltr"
			android:padding="50dp"/>
	</dna.familytree.MoveLayout>

	<!-- Floating frosted controls; system-bar insets are added to these margins in DiagramFragment -->
	<androidx.appcompat.widget.AppCompatImageButton
		android:id="@+id/diagram_hamburger"
		style="@style/Widget.FamilyTree.CanvasButton"
		android:contentDescription="@string/drawer_open"
		app:srcCompat="@drawable/ds_ic_menu" />

	<androidx.appcompat.widget.AppCompatImageButton
		android:id="@+id/diagram_options"
		style="@style/Widget.FamilyTree.CanvasButton"
		android:layout_gravity="end"
		android:contentDescription="@string/diagram_settings"
		app:srcCompat="@drawable/ds_ic_tune" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Premium paywall (docs/specs/paywall.md): hero, plans, Free vs Premium table, feature cards by group, trust, FAQ,
    restore/manage/legal, and a sticky purchase bar. Comparison rows, feature cards and FAQ items are added by
    PaywallController from PremiumFeature.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/paywall_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/paywall_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:liftOnScroll="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.FamilyTree.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ds_ic_close" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/paywall_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ds_page_gutter"
            android:paddingEnd="@dimen/ds_page_gutter"
            android:paddingBottom="@dimen/ds_space_lg">

            <!-- Hero -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ds_bg_premium_hero"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/ds_space_lg"
                android:paddingTop="@dimen/ds_space_lg"
                android:paddingEnd="@dimen/ds_space_lg"
                android:paddingBottom="@dimen/ds_space_md">

                <ImageView
                    android:layout_width="@dimen/paywall_icon_tile"
                    android:layout_height="@dimen/paywall_icon_tile"
                    android:background="@drawable/ds_bg_logo_tile"
                    android:contentDescription="@null"
                    android:elevation="2dp"
                    android:padding="16dp"
                    android:src="@drawable/ds_ic_diamond"
                    app:tint="@color/ds_tertiary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_md"
                    android:gravity="center"
                    android:text="@string/family_tree_premium"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="?attr/colorOnTertiaryContainer" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_xs"
                    android:gravity="center"
                    android:text="@string/paywall_subtitle"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnTertiaryContainer" />

                <TextView
                    android:id="@+id/paywall_reason"
                    style="@style/Widget.FamilyTree.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_md"
                    android:visibility="gone"
                    tools:text="Unlocks: Export PNG"
                    tools:visibility="visible" />

                <com.google.android.flexbox.FlexboxLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_md"
                    app:flexWrap="wrap"
                    app:justifyContent="center">

                    <TextView
                        style="@style/Widget.FamilyTree.PremiumHeroChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/paywall_highlight_no_ads" />

                    <TextView
                        style="@style/Widget.FamilyTree.PremiumHeroChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/paywall_highlight_backup" />

                    <TextView
                        style="@style/Widget.FamilyTree.PremiumHeroChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/paywall_highlight_reminders" />
                </com.google.android.flexbox.FlexboxLayout>
            </LinearLayout>

            <!-- Plans -->
            <TextView
                style="@style/Widget.FamilyTree.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="0dp"
                android:text="@string/choose_plan" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/paywall_plan_monthly"
                    style="@style/Widget.FamilyTree.Card.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/ds_space_sm"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:clickable="true"
                    android:focusable="true"
                    app:checkedIcon="@null">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/ds_space_md">

                        <ImageView
                            android:layout_width="@dimen/ds_icon"
                            android:layout_height="@dimen/ds_icon"
                            android:contentDescription="@null"
                            android:src="@drawable/ds_ic_autorenew"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_sm"
                            android:text="@string/plan_monthly"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/paywall_monthly_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_sm"
                            android:textAppearance="?attr/textAppearanceHeadlineSmall"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="$1.99" />

                        <TextView
                            android:id="@+id/paywall_monthly_period"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/plan_per_month"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/paywall_monthly_trial"
                            style="@style/Widget.FamilyTree.Pill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_sm"
                            android:visibility="gone"
                            tools:text="7-day free trial"
                            tools:visibility="visible" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_sm"
                            android:text="@string/plan_cancel_anytime"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/paywall_plan_lifetime"
                    style="@style/Widget.FamilyTree.Card.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/ds_space_sm"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:clickable="true"
                    android:focusable="true"
                    app:checkedIcon="@null">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/ds_space_md">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/ds_icon"
                                android:layout_height="@dimen/ds_icon"
                                android:contentDescription="@null"
                                android:src="@drawable/ds_ic_all_inclusive"
                                app:tint="?attr/colorPrimary" />

                            <Space
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <TextView
                                style="@style/Widget.FamilyTree.Pill.Premium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/plan_best_value" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_sm"
                            android:text="@string/plan_lifetime"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/paywall_lifetime_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_sm"
                            android:textAppearance="?attr/textAppearanceHeadlineSmall"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="$9.99" />

                        <TextView
                            android:id="@+id/paywall_lifetime_period"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/plan_one_time_payment"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/paywall_lifetime_savings"
                            style="@style/Widget.FamilyTree.Pill.Premium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_sm"
                            android:visibility="gone"
                            tools:text="Pays for itself in 5 months"
                            tools:visibility="visible" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_sm"
                            android:text="@string/plan_pay_once"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/paywall_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_md"
                android:indeterminate="true"
                android:visibility="gone"
                app:trackCornerRadius="2dp" />

            <!-- Free vs Premium -->
            <TextView
                style="@style/Widget.FamilyTree.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="0dp"
                android:text="@string/paywall_compare_title" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FamilyTree.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/paywall_compare"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/ds_space_sm"
                    android:paddingBottom="@dimen/ds_space_sm">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/ds_space_md"
                        android:paddingTop="@dimen/ds_space_sm"
                        android:paddingEnd="@dimen/ds_space_md"
                        android:paddingBottom="@dimen/ds_space_sm">

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1.4" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="@string/paywall_compare_free"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            style="@style/Widget.FamilyTree.Pill.Premium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="@string/paywall_compare_premium" />
                    </LinearLayout>
                    <!-- Rows: paywall_compare_row -->
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Everything in Premium: groups and feature cards -->
            <TextView
                style="@style/Widget.FamilyTree.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="0dp"
                android:text="@string/premium_benefits" />

            <LinearLayout
                android:id="@+id/paywall_features"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:orientation="vertical" />

            <!-- Trust -->
            <TextView
                style="@style/Widget.FamilyTree.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="0dp"
                android:text="@string/paywall_trust_title" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FamilyTree.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <dna.familytree.designsystem.SettingsRowView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:dsIcon="@drawable/ds_ic_verified"
                        app:dsShowDivider="true"
                        app:dsTitle="@string/paywall_trust_secure" />

                    <dna.familytree.designsystem.SettingsRowView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:dsIcon="@drawable/ds_ic_autorenew"
                        app:dsShowDivider="true"
                        app:dsTitle="@string/paywall_trust_cancel" />

                    <dna.familytree.designsystem.SettingsRowView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:dsIcon="@drawable/ds_ic_restore"
                        app:dsShowDivider="true"
                        app:dsTitle="@string/paywall_trust_devices" />

                    <dna.familytree.designsystem.SettingsRowView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:dsIcon="@drawable/ds_ic_lock"
                        app:dsTitle="@string/paywall_trust_private" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- FAQ -->
            <TextView
                style="@style/Widget.FamilyTree.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="0dp"
                android:text="@string/paywall_faq_title" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FamilyTree.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/paywall_faq"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_md"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/paywall_restore"
                    style="@style/Widget.FamilyTree.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/restore_purchases"
                    app:icon="@drawable/ds_ic_restore" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/paywall_manage"
                    style="@style/Widget.FamilyTree.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/manage_subscription"
                    app:icon="@drawable/ds_ic_open_in_new" />
            </LinearLayout>

            <TextView
                android:id="@+id/paywall_legal"
                style="@style/Widget.FamilyTree.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_sm"
                android:gravity="center"
                android:text="@string/legal_one_time" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Sticky purchase bar -->
    <LinearLayout
        android:id="@+id/paywall_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/paywall_bar_bg"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/ds_page_gutter"
        android:paddingTop="@dimen/ds_space_ms"
        android:paddingEnd="@dimen/ds_page_gutter"
        android:paddingBottom="@dimen/ds_space_ms">

        <TextView
            android:id="@+id/paywall_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ds_space_sm"
            android:gravity="center"
            android:text="@string/paywall_loading_prices"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/paywall_cta"
            style="@style/Widget.FamilyTree.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/paywall_cta_height"
            android:enabled="false"
            android:text="@string/cta_buy_lifetime"
            app:icon="@drawable/ds_ic_premium"
            app:iconGravity="textStart" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>

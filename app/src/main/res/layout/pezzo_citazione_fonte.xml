<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_marginTop="@dimen/ds_space_sm"
	android:background="@drawable/citation_background"
	android:foreground="@drawable/ds_ripple_card"
	android:orientation="vertical"
	android:padding="@dimen/ds_space_ms">

	<include
		android:id="@+id/citazione_fonte"
		layout="@layout/pezzo_fonte"
		android:layout_width="match_parent"
		android:layout_height="wrap_content" />

	<com.google.android.material.textview.MaterialTextView
		android:id="@+id/citazione_testo"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/ds_space_xs"
		android:textAppearance="@style/TextAppearance.FamilyTree.BodyMedium"/>

	<LinearLayout
		android:id="@+id/citazione_note"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- New name of a media file -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/ds_space_lg"
    android:paddingTop="@dimen/ds_space_sm"
    android:paddingEnd="@dimen/ds_space_lg">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/media_rename_layout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/media_info_name"
        app:startIconDrawable="@drawable/ds_ic_image">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/media_rename_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="text|textNoSuggestions"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>
</FrameLayout>

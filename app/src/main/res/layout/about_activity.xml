<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:liftOnScroll="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.FamilyTree.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/ds_space_xl"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ds_page_gutter"
            android:paddingEnd="@dimen/ds_page_gutter">

            <!-- Hero -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="@dimen/ds_space_lg"
                android:paddingBottom="@dimen/ds_space_md">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/zero"
                    android:layout_width="@dimen/ds_hero_icon"
                    android:layout_height="@dimen/ds_hero_icon"
                    app:shapeAppearance="@style/ShapeAppearance.FamilyTree.Large"
                    app:srcCompat="@mipmap/ic_launcher" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/uno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_md"
                    android:text="@string/app_name"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="?attr/colorOnSurface" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/due"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_xs"
                    android:text="@string/premium_tagline"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/app_version"
                    style="@style/Widget.FamilyTree.Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_ms" />
            </LinearLayout>

            <!-- Premium: active -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/about_subscribed"
                style="@style/Widget.FamilyTree.Card.Premium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/ds_space_md">

                    <ImageView
                        style="@style/Widget.FamilyTree.IconContainer.Premium"
                        android:background="@drawable/ds_bg_logo_tile"
                        android:contentDescription="@null"
                        android:src="@drawable/ds_ic_verified"
                        app:tint="@color/ds_tertiary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/about_premium_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/premium_status_lifetime"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnTertiaryContainer" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/premium_status_active"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnTertiaryContainer" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Premium: upsell -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/about_product"
                style="@style/Widget.FamilyTree.Card.Premium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/ds_space_md">

                    <ImageView
                        style="@style/Widget.FamilyTree.IconContainer.Premium"
                        android:background="@drawable/ds_bg_logo_tile"
                        android:contentDescription="@null"
                        android:src="@drawable/ds_ic_premium"
                        app:tint="@color/ds_tertiary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/go_premium"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnTertiaryContainer" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/go_premium_desc"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnTertiaryContainer" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/ds_icon"
                        android:layout_height="@dimen/ds_icon"
                        android:contentDescription="@null"
                        android:src="@drawable/ds_ic_chevron_right"
                        app:tint="?attr/colorOnTertiaryContainer" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Links -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FamilyTree.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <dna.familytree.designsystem.SettingsRowView
                        android:id="@+id/app_link"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:dsIcon="@drawable/ds_ic_open_in_new"
                        app:dsShowDivider="true"
                        app:dsSubtitle="digitalailabs.blogspot.com"
                        app:dsTitle="@string/website"
                        app:dsTrailing="chevron" />

                    <dna.familytree.designsystem.SettingsRowView
                        android:id="@+id/about_rate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:dsIcon="@drawable/ds_ic_star"
                        app:dsShowDivider="true"
                        app:dsSubtitle="@string/rate_desc"
                        app:dsTitle="@string/rate"
                        app:dsTrailing="chevron" />

                    <dna.familytree.designsystem.SettingsRowView
                        android:id="@+id/about_share"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:dsIcon="@drawable/ds_ic_share"
                        app:dsShowDivider="true"
                        app:dsSubtitle="@string/share_desc"
                        app:dsTitle="@string/share"
                        app:dsTrailing="chevron" />

                    <dna.familytree.designsystem.SettingsRowView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:dsIcon="@drawable/ds_ic_layers"
                        app:dsSubtitle="@string/tagline"
                        app:dsTitle="@string/open_source_license" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <dna.familytree.feature.ads.NativeAdCard
                android:id="@+id/my_template"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:nativeAdSize="large" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>

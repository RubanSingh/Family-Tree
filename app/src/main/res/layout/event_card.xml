<?xml version="1.0" encoding="utf-8"?>
<!-- One event: avatar or kind icon, kind, title, details, date tile with countdown, notification state -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.FamilyTree.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/ds_page_gutter"
    android:layout_marginTop="5dp"
    android:layout_marginEnd="@dimen/ds_page_gutter"
    android:layout_marginBottom="5dp"
    app:cardCornerRadius="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="84dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ds_space_ms"
        android:paddingTop="@dimen/ds_space_ms"
        android:paddingEnd="@dimen/ds_space_ms"
        android:paddingBottom="@dimen/ds_space_ms">

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp">

            <ImageView
                android:id="@+id/event_icon"
                style="@style/Widget.FamilyTree.IconContainer.Primary"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:padding="14dp"
                android:contentDescription="@null"
                tools:src="@drawable/ds_ic_cake" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/event_photo"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearance="@style/ShapeAppearance.FamilyTree.Circle" />

            <ImageView
                android:id="@+id/event_badge"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/ds_bg_icon_container_primary"
                android:contentDescription="@null"
                android:padding="4dp"
                android:visibility="gone"
                app:tint="?attr/colorOnPrimaryContainer"
                tools:src="@drawable/ds_ic_cake"
                tools:visibility="visible" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/event_kind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:background="@drawable/ds_bg_pill_primary"
                android:paddingStart="@dimen/ds_space_sm"
                android:paddingTop="1dp"
                android:paddingEnd="@dimen/ds_space_sm"
                android:paddingBottom="1dp"
                android:textAllCaps="true"
                android:textAppearance="@style/TextAppearance.FamilyTree.LabelSmall"
                android:textColor="?attr/colorOnPrimaryContainer"
                tools:text="Birthday" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/event_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.FamilyTree.TitleMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="Maria Rossi" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/event_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.FamilyTree.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Turns 34 · Saturday" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/event_tile"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_sm"
            android:background="@drawable/event_date_tile"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="@dimen/ds_space_sm"
            android:paddingBottom="@dimen/ds_space_sm">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/event_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface"
                tools:text="12" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/event_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:textAppearance="@style/TextAppearance.FamilyTree.LabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Mar" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/event_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:maxLines="2"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textAppearance="@style/TextAppearance.FamilyTree.LabelSmall"
                android:textColor="?attr/colorPrimary"
                tools:text="in 3 days" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

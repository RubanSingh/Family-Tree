<?xml version="1.0" encoding="utf-8"?>
<!-- Banner with an action: notifications permission, or Premium invitation -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/events_banner"
    style="@style/Widget.FamilyTree.Card.Outlined"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/ds_page_gutter"
    android:layout_marginTop="@dimen/ds_space_xs"
    android:layout_marginEnd="@dimen/ds_page_gutter"
    android:layout_marginBottom="@dimen/ds_space_xs"
    app:cardCornerRadius="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/ds_space_md">

        <ImageView
            android:id="@+id/events_banner_icon"
            style="@style/Widget.FamilyTree.IconContainer.Primary"
            android:contentDescription="@null"
            tools:src="@drawable/ds_ic_notifications" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/events_banner_title"
                style="@style/Widget.FamilyTree.ListTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Turn on notifications" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/events_banner_desc"
                style="@style/Widget.FamilyTree.ListSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                tools:text="Allow notifications to be reminded of birthdays and family events." />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/events_banner_action"
            style="@style/Widget.FamilyTree.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_sm"
            android:minHeight="40dp"
            android:paddingStart="@dimen/ds_space_md"
            android:paddingEnd="@dimen/ds_space_md"
            tools:text="Allow" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

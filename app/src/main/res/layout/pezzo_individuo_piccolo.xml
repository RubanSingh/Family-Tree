<?xml version="1.0" encoding="utf-8"?>
<!-- Compact linked-person row (family detail, sharing). collega_bordo = gender ring around the avatar. -->
<FrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_marginTop="4dp"
	android:layout_marginBottom="4dp"
	android:background="@drawable/person_row_background">
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@drawable/ds_ripple_card"
		android:gravity="center_vertical"
		android:minHeight="68dp"
		android:orientation="horizontal"
		android:paddingStart="@dimen/ds_space_ms"
		android:paddingTop="10dp"
		android:paddingEnd="@dimen/ds_space_sm"
		android:paddingBottom="10dp">
		<FrameLayout
			android:layout_width="50dp"
			android:layout_height="50dp">
			<View
				android:id="@+id/collega_bordo"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:background="@drawable/person_ring_neutral"/>
			<androidx.appcompat.widget.AppCompatImageView
				style="@style/Widget.FamilyTree.AvatarPlaceholder"
				android:layout_width="42dp"
				android:layout_height="42dp"
				android:layout_gravity="center"
				android:padding="10dp"/>
			<com.google.android.material.imageview.ShapeableImageView
				android:id="@+id/collega_foto"
				android:layout_width="42dp"
				android:layout_height="42dp"
				android:layout_gravity="center"
				android:scaleType="centerCrop"
				app:shapeAppearance="@style/ShapeAppearance.FamilyTree.Circle"/>
			<ImageView
				android:id="@+id/collega_lutto"
				style="@style/Widget.FamilyTree.MourningBadge"
				android:layout_width="18dp"
				android:layout_height="18dp"
				android:layout_gravity="bottom|end"
				android:background="@drawable/mourning_badge_ringed"
				android:padding="4dp"/>
		</FrameLayout>
		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginStart="@dimen/ds_space_ms"
			android:layout_weight="1"
			android:orientation="vertical">
			<TextView
				android:id="@+id/collega_nome"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:textAppearance="@style/TextAppearance.FamilyTree.TitleSmall"
				android:textColor="?attr/colorOnSurface"/>
			<TextView
				android:id="@+id/collega_dati"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="2dp"
				android:textAppearance="@style/TextAppearance.FamilyTree.BodySmall"
				android:textColor="?attr/colorOnSurfaceVariant"/>
		</LinearLayout>
		<ImageView
			android:layout_width="20dp"
			android:layout_height="20dp"
			android:contentDescription="@null"
			android:importantForAccessibility="no"
			android:src="@drawable/ds_ic_chevron_right"
			app:tint="?attr/colorOutline"/>
	</LinearLayout>
</FrameLayout>

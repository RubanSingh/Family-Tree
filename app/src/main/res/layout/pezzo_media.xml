<?xml version="1.0" encoding="utf-8"?>
<!--
    Media tile (galleries, profile media, linked media). Full-bleed rounded image, caption on a scrim,
    usage count as a glass pill. MediaAdapter / AppUtils may replace the layout params (compact thumbnails).
-->
<com.google.android.material.card.MaterialCardView
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="220dp"
	android:layout_margin="4dp"
	app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
	app:cardCornerRadius="@dimen/ds_radius_md"
	app:cardElevation="0dp"
	app:strokeWidth="0dp">

	<ImageView
		android:id="@+id/media_img"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:contentDescription="@null"
		android:scaleType="centerCrop"
		app:srcCompat="@drawable/image" />

	<TextView
		android:id="@+id/media_testo"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="bottom"
		android:background="@drawable/media_caption_scrim"
		android:ellipsize="end"
		android:maxLines="2"
		android:paddingStart="@dimen/ds_space_ms"
		android:paddingTop="28dp"
		android:paddingEnd="@dimen/ds_space_ms"
		android:paddingBottom="10dp"
		android:textAppearance="@style/TextAppearance.FamilyTree.LabelLarge"
		android:textColor="@android:color/white" />

	<TextView
		android:id="@+id/media_num"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="top|end"
		android:layout_margin="@dimen/ds_space_sm"
		android:background="@drawable/media_count_badge"
		android:minWidth="26dp"
		android:gravity="center"
		android:paddingStart="@dimen/ds_space_sm"
		android:paddingTop="2dp"
		android:paddingEnd="@dimen/ds_space_sm"
		android:paddingBottom="2dp"
		android:textAppearance="@style/TextAppearance.FamilyTree.LabelMedium"
		android:textColor="@android:color/white" />

	<ProgressBar
		android:id="@+id/media_circolo"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_gravity="center"
		android:visibility="gone" />

</com.google.android.material.card.MaterialCardView>

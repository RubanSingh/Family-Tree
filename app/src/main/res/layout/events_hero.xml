<?xml version="1.0" encoding="utf-8"?>
<!-- Next event, at the top of Events & reminders -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.FamilyTree.Card.Primary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/ds_page_gutter"
    android:layout_marginTop="@dimen/ds_space_xs"
    android:layout_marginEnd="@dimen/ds_page_gutter"
    android:layout_marginBottom="@dimen/ds_space_sm"
    app:cardCornerRadius="@dimen/ds_radius_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp">

        <ImageView
            android:id="@+id/events_hero_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/ds_bg_logo_tile"
            android:backgroundTint="?attr/colorSurface"
            android:contentDescription="@null"
            android:padding="14dp"
            app:tint="?attr/colorPrimary"
            tools:src="@drawable/ds_ic_cake" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/events_hero_overline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/events_next_up"
                android:textAllCaps="true"
                android:textAppearance="@style/TextAppearance.FamilyTree.Overline"
                android:textColor="?attr/colorOnPrimaryContainer" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/events_hero_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="?attr/colorOnPrimaryContainer"
                tools:text="Maria Rossi" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/events_hero_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnPrimaryContainer"
                tools:text="Turns 34 · Saturday, 12 March" />
        </LinearLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/events_hero_when"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_sm"
            android:background="@drawable/ds_bg_pill_premium"
            android:paddingStart="@dimen/ds_space_ms"
            android:paddingTop="@dimen/ds_space_xs"
            android:paddingEnd="@dimen/ds_space_ms"
            android:paddingBottom="@dimen/ds_space_xs"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnTertiaryContainer"
            tools:text="in 3 days" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

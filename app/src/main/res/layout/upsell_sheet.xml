<?xml version="1.0" encoding="utf-8"?>
<!--
    Premium invitation shown after enough use (docs/specs/upsell-prompt.md): personal hero with the user's numbers,
    the most wanted Premium features, price teaser and one call to action. Built by feature/billing/UpsellPrompt.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ds_page_gutter"
        android:paddingEnd="@dimen/ds_page_gutter"
        android:paddingBottom="@dimen/ds_space_md">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Hero -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ds_bg_premium_hero">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/ds_space_md"
                android:paddingTop="@dimen/ds_space_md"
                android:paddingEnd="@dimen/ds_space_md"
                android:paddingBottom="@dimen/ds_space_md">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/ds_bg_logo_tile"
                    android:contentDescription="@null"
                    android:elevation="2dp"
                    android:padding="12dp"
                    android:src="@drawable/ds_ic_diamond"
                    app:tint="@color/ds_tertiary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_ms"
                    android:gravity="center"
                    android:text="@string/upsell_title"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="?attr/colorOnTertiaryContainer" />

                <TextView
                    android:id="@+id/upsell_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_xs"
                    android:gravity="center"
                    android:text="@string/upsell_subtitle"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnTertiaryContainer" />

                <!-- The user's own numbers -->
                <LinearLayout
                    android:id="@+id/upsell_stats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_md"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/upsell_stat_people"
                        layout="@layout/upsell_stat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/upsell_stat_trees"
                        layout="@layout/upsell_stat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_sm"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/upsell_stat_generations"
                        layout="@layout/upsell_stat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_sm"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Highlights: upsell_feature rows -->
        <LinearLayout
            android:id="@+id/upsell_features"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_sm"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/upsell_more"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="@dimen/ds_space_md"
            android:paddingEnd="@dimen/ds_space_md"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorPrimary"
            tools:text="and 4 more Premium features" />

        <TextView
            android:id="@+id/upsell_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_sm"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurface"
            android:visibility="gone"
            tools:text="Plans from $1.99 per month\nor pay once $9.99 and keep it forever"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/upsell_cta"
            style="@style/Widget.FamilyTree.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/paywall_cta_height"
            android:layout_marginTop="@dimen/ds_space_md"
            android:text="@string/upsell_cta"
            app:icon="@drawable/ds_ic_premium"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/upsell_later"
            style="@style/Widget.FamilyTree.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_xs"
            android:text="@string/upsell_later" />

        <TextView
            style="@style/Widget.FamilyTree.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_xs"
            android:gravity="center"
            android:text="@string/upsell_trust" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

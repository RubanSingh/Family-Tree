<?xml version="1.0" encoding="utf-8"?>
<!--
    Family card: partners and children in labelled columns.
    family_strut is the whole children column: FamiliesFragment hides it (with family_children) when there are none.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.FamilyTree.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    app:cardCornerRadius="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/ds_space_md">

        <ImageView
            style="@style/Widget.FamilyTree.IconContainer.Primary"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:contentDescription="@null"
            android:src="@drawable/ds_ic_family" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Sort key (id, surname, members) -->
            <TextView
                android:id="@+id/family_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ds_space_sm"
                android:background="@drawable/ds_bg_pill_primary"
                android:paddingStart="@dimen/ds_space_sm"
                android:paddingTop="1dp"
                android:paddingEnd="@dimen/ds_space_sm"
                android:paddingBottom="1dp"
                android:textAppearance="@style/TextAppearance.FamilyTree.LabelSmall"
                android:textColor="?attr/colorOnPrimaryContainer" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/partners"
                        android:textAppearance="@style/TextAppearance.FamilyTree.Overline"
                        android:textColor="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/family_parents"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:lineSpacingExtra="2dp"
                        android:textAppearance="@style/TextAppearance.FamilyTree.TitleSmall"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/family_strut"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/ds_space_ms"
                        android:layout_marginEnd="@dimen/ds_space_ms" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/family_card_children"
                            android:textAppearance="@style/TextAppearance.FamilyTree.Overline"
                            android:textColor="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/family_children"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:lineSpacingExtra="2dp"
                            android:textAppearance="@style/TextAppearance.FamilyTree.BodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

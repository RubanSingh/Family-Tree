<?xml version="1.0" encoding="utf-8"?>
<!-- Tree settings: life span of living people and the date ages are counted to -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.FamilyTree.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/ds_space_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingStart="@dimen/ds_page_gutter"
            android:paddingTop="@dimen/ds_space_sm"
            android:paddingEnd="@dimen/ds_page_gutter">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FamilyTree.Card.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/ds_space_md">

                    <ImageView
                        style="@style/Widget.FamilyTree.IconContainer"
                        android:background="@drawable/ds_bg_logo_tile"
                        android:backgroundTint="?attr/colorSurface"
                        android:contentDescription="@null"
                        android:src="@drawable/ds_ic_account_tree"
                        app:tint="?attr/colorPrimary" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tree_settings_intro"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_md"
                        android:layout_weight="1"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnPrimaryContainer" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Living people -->
            <com.google.android.material.textview.MaterialTextView
                style="@style/Widget.FamilyTree.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/ds_space_xs"
                android:text="@string/tree_settings_living" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FamilyTree.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/ds_space_md">

                    <ImageView
                        style="@style/Widget.FamilyTree.IconContainer"
                        android:contentDescription="@null"
                        android:src="@drawable/ds_ic_hourglass" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Widget.FamilyTree.ListTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/max_life_span" />

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Widget.FamilyTree.ListSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/tree_settings_life_desc" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tree_settings_years_layout"
                            android:layout_width="160dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_ms"
                            android:hint="@string/years">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/tree_settings_years"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:inputType="number"
                                android:maxLength="3" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Ages -->
            <com.google.android.material.textview.MaterialTextView
                style="@style/Widget.FamilyTree.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/ds_space_xs"
                android:text="@string/tree_settings_ages" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.FamilyTree.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/ds_space_md">

                    <ImageView
                        style="@style/Widget.FamilyTree.IconContainer"
                        android:contentDescription="@null"
                        android:src="@drawable/ds_ic_event" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_space_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Widget.FamilyTree.ListTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/current_date" />

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/Widget.FamilyTree.ListSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/tree_settings_date_desc" />

                        <RadioGroup
                            android:id="@+id/tree_settings_date_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_space_sm">

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/tree_settings_device_date"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="@dimen/ds_touch_target"
                                android:text="@string/device_date" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/tree_settings_fixed_date"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="@dimen/ds_touch_target"
                                android:text="@string/fixed_date" />
                        </RadioGroup>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/tree_settings_date"
                            style="@style/Widget.FamilyTree.Button.Outlined"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="32dp"
                            app:icon="@drawable/ds_ic_event"
                            app:iconSize="18dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>

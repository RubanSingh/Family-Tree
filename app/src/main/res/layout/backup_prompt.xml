<?xml version="1.0" encoding="utf-8"?>
<!-- Trees screen invitation to switch on local backup by choosing a folder -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/backup_prompt"
    style="@style/Widget.FamilyTree.Card.Primary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/ds_page_gutter"
    android:layout_marginTop="@dimen/ds_space_xs"
    android:layout_marginEnd="@dimen/ds_page_gutter"
    android:layout_marginBottom="@dimen/ds_space_xs"
    android:visibility="gone"
    app:cardCornerRadius="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ds_space_md"
        android:paddingTop="@dimen/ds_space_md"
        android:paddingEnd="@dimen/ds_space_md"
        android:paddingBottom="@dimen/ds_space_sm">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                style="@style/Widget.FamilyTree.IconContainer"
                android:background="@drawable/ds_bg_logo_tile"
                android:backgroundTint="?attr/colorSurface"
                android:contentDescription="@null"
                android:src="@drawable/ds_ic_backup"
                app:tint="?attr/colorPrimary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/backup_prompt_title"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/backup_prompt_desc"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnPrimaryContainer" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_xs"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backup_prompt_later"
                style="@style/Widget.FamilyTree.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:text="@string/backup_not_now" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backup_prompt_choose"
                style="@style/Widget.FamilyTree.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_xs"
                android:minHeight="40dp"
                android:text="@string/choose_folder"
                app:icon="@drawable/ds_ic_folder"
                app:iconSize="18dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

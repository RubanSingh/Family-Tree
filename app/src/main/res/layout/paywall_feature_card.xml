<?xml version="1.0" encoding="utf-8"?>
<!-- A Premium feature on the paywall: icon, title, summary, Free / Premium pills; tap shows "how it works". -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.FamilyTree.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/ds_space_sm"
    android:clickable="true"
    android:focusable="true"
    app:strokeColor="?attr/colorTertiary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/ds_space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/feature_icon"
                style="@style/Widget.FamilyTree.IconContainer.Premium"
                android:layout_width="@dimen/ds_icon_container"
                android:layout_height="@dimen/ds_icon_container"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/feature_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/feature_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <ImageView
                android:id="@+id/feature_chevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="@dimen/ds_space_sm"
                android:contentDescription="@null"
                android:src="@drawable/ic_expand_more"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <com.google.android.flexbox.FlexboxLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="56dp"
            android:layout_marginTop="@dimen/ds_space_sm"
            app:flexWrap="wrap">

            <TextView
                android:id="@+id/feature_free"
                style="@style/Widget.FamilyTree.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="@dimen/ds_space_sm"
                android:background="@drawable/paywall_free_pill_bg"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/feature_premium"
                style="@style/Widget.FamilyTree.Pill.Premium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />
        </com.google.android.flexbox.FlexboxLayout>

        <!-- How it works -->
        <LinearLayout
            android:id="@+id/feature_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="56dp"
            android:layout_marginTop="@dimen/ds_space_ms"
            android:orientation="vertical"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

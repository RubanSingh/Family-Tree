<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".merge.MergeController">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.FamilyTree.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize" />

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="15dp"
                    android:paddingTop="30dp"
                    android:paddingEnd="15dp"
                    android:paddingBottom="50dp">

                    <include
                        android:id="@+id/merge_firstTree"
                        layout="@layout/pezzo_albero" />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/AppTheme.Suggestion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="30dp"
                        android:layout_marginBottom="10dp"
                        android:text="@string/select_tree" />

                    <LinearLayout
                        android:id="@+id/merge_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="50dp"
                        android:orientation="vertical" />

                    <!-- Searches persons with the same name in both trees, to merge them -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/merge_next"
                        style="@style/Widget.FamilyTree.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:enabled="false"
                        android:minWidth="240dp"
                        android:text="@string/search_duplicates" />

                    <!-- Merges the trees without searching duplicates (from Family Gem) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/merge_skip"
                        style="@style/Widget.FamilyTree.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/ds_space_sm"
                        android:enabled="false"
                        android:minWidth="240dp"
                        android:text="@string/skip" />
                </LinearLayout>
            </ScrollView>

            <include layout="@layout/progress" />
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </LinearLayout>
</layout>

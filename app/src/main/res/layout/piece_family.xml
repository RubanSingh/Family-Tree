<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	style="@style/Widget.FamilyTree.Card"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_marginTop="4dp"
	android:layout_marginBottom="4dp"
	app:contentPadding="@dimen/ds_space_md">
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center_vertical"
		android:orientation="horizontal">
		<ImageView
			style="@style/Widget.FamilyTree.IconContainer.Primary"
			android:layout_marginEnd="@dimen/ds_space_md"
			android:contentDescription="@null"
			android:src="@drawable/ds_ic_family" />
		<TextView
			android:id="@+id/family_text"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:singleLine="false"
			android:textAppearance="@style/TextAppearance.FamilyTree.BodyLarge"
			android:textColor="?attr/colorOnSurface"/>
	</LinearLayout>
</com.google.android.material.card.MaterialCardView>

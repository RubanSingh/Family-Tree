<?xml version="1.0" encoding="utf-8"?>
<!--
    A free user tapped a one-off Premium action (docs/specs/ads.md, "Rewarded videos"): use it once after a short
    video, or go Premium. Built by feature/ads/RewardedUnlock.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/ds_page_gutter"
    android:paddingEnd="@dimen/ds_page_gutter"
    android:paddingBottom="@dimen/ds_space_lg">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- The feature -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/reward_icon"
            style="@style/Widget.FamilyTree.IconContainer.Premium"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@null"
            android:padding="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/reward_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="?attr/colorOnSurface"
                tools:text="Export PNG" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:text="@string/reward_premium_feature"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:drawableStartCompat="@drawable/ds_ic_diamond_small"
                app:drawableTint="?attr/colorTertiary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Once, with a video -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/reward_watch"
        style="@style/Widget.FamilyTree.Card.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_lg"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/ds_space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    style="@style/Widget.FamilyTree.IconContainer.Primary"
                    android:layout_width="@dimen/ds_icon_container"
                    android:layout_height="@dimen/ds_icon_container"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_play_circle" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/reward_watch_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/reward_watch_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/reward_watch_desc"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/reward_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_ms"
                android:indeterminate="true"
                android:visibility="gone"
                app:trackCornerRadius="2dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Premium -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/reward_premium"
        style="@style/Widget.FamilyTree.Card.Premium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_ms"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/ds_space_md">

            <ImageView
                android:layout_width="@dimen/ds_icon_container"
                android:layout_height="@dimen/ds_icon_container"
                android:background="@drawable/ds_bg_logo_tile"
                android:contentDescription="@null"
                android:padding="@dimen/ds_space_sm"
                android:src="@drawable/ds_ic_diamond"
                app:tint="@color/ds_tertiary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/go_premium"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnTertiaryContainer" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/reward_premium_desc"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnTertiaryContainer" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ds_ic_chevron_right"
                app:tint="?attr/colorOnTertiaryContainer" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Cancel / Done actions placed in the toolbar while editing -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:gravity="end|center_vertical"
	android:orientation="horizontal"
	android:paddingEnd="@dimen/ds_space_sm">

	<com.google.android.material.button.MaterialButton
		android:id="@+id/edita_annulla"
		style="@style/Widget.FamilyTree.Button.Text"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:minHeight="40dp"
		android:text="@string/cancel" />

	<com.google.android.material.button.MaterialButton
		android:id="@+id/edita_salva"
		style="@style/Widget.FamilyTree.Button"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginStart="@dimen/ds_space_xs"
		android:minHeight="40dp"
		android:paddingStart="@dimen/ds_space_md"
		android:paddingEnd="20dp"
		android:text="@string/done"
		app:icon="@drawable/ds_ic_check"
		app:iconSize="18dp" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Person card on the tree canvas.
    card_background: fill (base / partner / focus, set in DiagramFragment)
    card_border: gender outline (neutral / male / female, set in DiagramFragment)
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="30dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/card_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/casella_sfondo_base"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/card_border"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/nutral"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/card_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/ds_ripple_card"
        android:gravity="center_horizontal"
        android:minWidth="104dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/ds_space_ms"
        android:paddingTop="@dimen/ds_space_ms"
        android:paddingEnd="@dimen/ds_space_ms"
        android:paddingBottom="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Avatar: the silhouette shows through when the person has no photo (card_photo becomes GONE) -->
        <FrameLayout
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginBottom="@dimen/ds_space_sm">

            <androidx.appcompat.widget.AppCompatImageView
                style="@style/Widget.FamilyTree.AvatarPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="14dp" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/card_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="2dp"
                android:scaleType="centerCrop"
                app:shapeAppearance="@style/ShapeAppearance.FamilyTree.Circle"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="2dp" />
        </FrameLayout>

        <dna.familytree.ElasticTextView
            android:id="@+id/card_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:maxWidth="200dp"
            android:textAppearance="@style/TextAppearance.FamilyTree.TitleSmall"
            android:textColor="?attr/colorOnSurface" />

        <dna.familytree.ElasticTextView
            android:id="@+id/card_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:maxWidth="200dp"
            android:textAppearance="@style/TextAppearance.FamilyTree.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/card_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_horizontal"
            android:textAppearance="@style/TextAppearance.FamilyTree.LabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/card_mourn"
        style="@style/Widget.FamilyTree.MourningBadge"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>

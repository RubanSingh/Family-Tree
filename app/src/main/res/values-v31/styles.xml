<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Android 12+ system splash: same base colour and centred logo medallion as splash.xml,
        so the system splash hands off to the app splash without a visible jump.
    -->
    <style name="SplashTheme" parent="Theme.FamilyTree.Splash">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_medallion</item>
    </style>
</resources>

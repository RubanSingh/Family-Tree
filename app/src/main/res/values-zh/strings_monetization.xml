    <!-- Premium features -->
    <string name="pf_backup_title">自动备份</string>
    <string name="pf_backup_summary">每次更改都会自动保存到你选择的文件夹，无需动手。</string>
    <string name="pf_backup_free">手动备份</string>
    <string name="pf_backup_premium">自动</string>
    <string name="pf_backup_detail1">每次编辑约一分钟后，家谱会以 ZIP 备份的形式保存到你的文件夹：手机存储、SD 卡或 Google Drive 等云端文件夹。</string>
    <string name="pf_backup_detail2">每个家谱都会保留最近的 3 份副本，让你随时可以回到之前的版本。</string>
    <string name="pf_backup_detail3">恢复备份完全免费且随时可用，即使没有高级版也可以。</string>

    <string name="pf_media_title">媒体整理</string>
    <string name="pf_media_summary">一次性将家谱中的所有照片和文档复制到应用中。</string>
    <string name="pf_media_free">每次一个文件</string>
    <string name="pf_media_premium">一次处理全部文件</string>
    <string name="pf_media_detail1">将家谱的所有媒体导入应用存储，显示进度并可随时取消，即使文件移动，链接也不会失效。</string>
    <string name="pf_media_detail2">你的原始文件不受影响：每个文件都会先复制并校验，然后才更新其链接。</string>

    <string name="pf_reminders_title">智能家庭提醒</string>
    <string name="pf_reminders_summary">结婚纪念日、逝世纪念日以及无限个人提醒。</string>
    <string name="pf_reminders_free">生日 + 2 个提醒</string>
    <string name="pf_reminders_premium">无限</string>
    <string name="pf_reminders_detail1">接收夫妇结婚纪念日的通知，也可以按需接收逝世纪念日的通知。</string>
    <string name="pf_reminders_detail2">想创建多少提醒都可以：迎婴派对、毕业典礼、家庭聚会、探访…</string>
    <string name="pf_reminders_detail3">提前提醒让你预先知晓，留出时间打电话、写信或准备礼物。</string>

    <string name="pf_places_title">家族地点</string>
    <string name="pf_places_summary">家族历史中的每个地点，均可搜索，一点即可在地图中查看。</string>
    <string name="pf_places_free">前 3 个地点</string>
    <string name="pf_places_premium">全部地点</string>
    <string name="pf_places_detail1">家谱中的所有事件地点和地址，按国家分组，并支持搜索。</string>
    <string name="pf_places_detail2">查看每个地点发生过的事件，并在地图应用中打开，获取路线。</string>

    <string name="pf_exports_title">可直接打印的导出</string>
    <string name="pf_exports_summary">将你的家谱图转换为高清图片或 PDF，方便打印和分享。</string>
    <string name="pf_exports_free_legacy">PDF</string>
    <string name="pf_exports_free_video">每看一次视频可用一次</string>
    <string name="pf_exports_premium">PDF + 高清图片</string>
    <string name="pf_exports_detail1">将家谱图导出为高分辨率 PNG 图片，非常适合在聊天和社交网络中分享。</string>
    <string name="pf_exports_detail2">生成整个家谱图的 PDF，可直接打印成海报，用于家庭聚会。</string>
    <string name="pf_exports_detail3">打印样式采用白色背景和清晰线条，尺寸随家谱自动调整。</string>
    <string name="pf_exports_detail4">没有高级版时，看完一段短视频后仍可导出一次。</string>

    <string name="pf_merge_title">合并家谱</string>
    <string name="pf_merge_summary">将两个家谱合并为一个，并自动为你找出重复项。</string>
    <string name="pf_merge_detail1">应用会在两个家谱中查找相同的人，你可以逐一确认匹配，也可以一次全部确认。</string>
    <string name="pf_merge_detail2">当亲戚把他们自己的家谱发给你时，这再合适不过。</string>

    <string name="pf_advanced_title">高级工具</string>
    <string name="pf_advanced_summary">来源、存储库、GEDCOM 导出以及完整的家谱研究工具集。</string>
    <string name="pf_advanced_detail1">像专业家谱学家一样引用来源和存储库，并管理提交人。</string>
    <string name="pf_advanced_detail2">将家谱导出为 GEDCOM（可含或不含媒体），适用于任何家谱软件，还可创建完整的 ZIP 备份。</string>
    <string name="pf_advanced_detail3">比较共享的家谱，并整理媒体文件的路径。</string>


<?xml version="1.0" encoding="utf-8"?>
<!-- Splash: brand base colour with a soft light bloom behind the centred logo -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/splash_background" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.5"
                android:centerY="0.5"
                android:endColor="#000B57D0"
                android:gradientRadius="320dp"
                android:startColor="#660B57D0"
                android:type="radial" />
        </shape>
    </item>
</layer-list>

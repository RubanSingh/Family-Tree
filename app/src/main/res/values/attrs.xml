<resources>
    <declare-styleable name="NativeAdCard">
        <!-- small: compact card for lists; large: with the media, for the end of a page -->
        <attr name="nativeAdSize" format="enum">
            <enum name="small" value="0" />
            <enum name="large" value="1" />
        </attr>
    </declare-styleable>
</resources>
